{
  "name": "cyber-wrestling-chat",
  "version": "1.0.0",
  "description": "Cyber Wrestling Chatroom with MongoDB, Socket.IO, Admin Panel, and Analytics",
  "main": "electron/main.js",
  "scripts": {
    "build": "node build.js",
    "prestart": "node build.js",
    "start": "node index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.0",
    "esbuild": "^0.25.12",
    "express": "^4.19.0",
    "express-rate-limit": "^7.0.0",
    "form-data": "^4.0.0",
    "helmet": "^7.0.0",
    "mongoose": "^8.3.0",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^2.6.7",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.malecyberfighters.app",
    "productName": "Male Cyber Fighters",
    "artifactName": "CyberFights-${os}.${ext}",
    "asar": true,
    "npmRebuild": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "dmDelivery.js",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/mcf-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/images/mcf-512.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/mcf-512.png",
      "category": "Network",
      "maintainer": "Male Cyber Fighters"
    }
  }
}
