# Male Cyber Fighters — environment configuration
#
# Copy this file to `.env` (the server reads `.env`) and fill in your values.
#   cp .env.example .env
#
# The file is plain text and should NOT be committed. Keep it out of version
# control (`.env` is already ignored).

# --- Server ---
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/cyberfights

# Public base URL used in password-reset emails (e.g. https://malecyberfighters.com).
# If left blank, the server derives it from the incoming request, which works
# behind a reverse proxy that sets X-Forwarded-Proto/Host.
APP_BASE_URL=

# --- Admin panel ---
# The x-admin-key required to access /api/admin/* endpoints.
ADMIN_KEY=change-me

# --- Email (SMTP) ---
# To make the website send mail from administrator@male-cyber-fighters.com,
# fill in the SMTP details for whatever hosts that mailbox.
#
#   Gmail                 smtp.gmail.com        (enable 2FA, use an App Password)
#   Google Workspace      smtp.gmail.com
#   Zoho Mail             smtp.zoho.com
#   Outlook/Microsoft 365 smtp.office365.com
#   Namecheap Private     mail.privateemail.com
#   Fastmail              smtp.fastmail.com
#
# SMTP_USER / SMTP_PASS are the credentials for the sender account.
# For security, use an app-specific password, not your normal password.
SMTP_HOST=
SMTP_PORT=587                 # 587 = STARTTLS, 465 = SSL/TLS
SMTP_SECURE=false             # set true only when SMTP_PORT is 465
SMTP_USER=                    # e.g. administrator (the part before @male-cyber-fighters.com)
SMTP_PASS=
MAIL_FROM=administrator@male-cyber-fighters.com

# Send an email to the admin mailbox on every new user registration (true/false).
# Requires the SMTP settings above.
EMAIL_ADMIN_ALERTS=false

# --- Optional integrations ---
# Discord webhook for public chat messages.
Discord_webhook=
Discord_Support=
# ImgBB API key for image uploads (https://api.imgbb.com).
IMGBB_API_KEY=
