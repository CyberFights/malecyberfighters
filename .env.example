# Male Cyber Fighters — environment configuration
#
# Copy this file to `.env` (the server reads `.env`) and fill in your values.
#   cp .env.example .env
#
# The file is plain text and should NOT be committed. Keep it out of version
# control (`.env` is already ignored).

# --- Server ---
PORT=3000

# Public base URL used in password-reset emails and in the avatar URLs sent
# with public-chat messages relayed to the Discord webhook (e.g.
# https://male-cyber-fighters.com). If left blank, the server derives it from
# the incoming request, which works behind a reverse proxy that sets
# X-Forwarded-Proto/Host.
APP_BASE_URL=

# --- Admin panel ---
# The x-admin-key required to access /api/admin/* endpoints.
ADMIN_KEY=

# --- Discord -> arena bridge ---
# Shared secret for POST /api/chatMessage, the ingress the Discord bridge uses
# to publish a channel message into the arena. That caller is not a signed-in
# browser, so it authenticates with this key (sent as x-chat-ingress-key)
# instead of a member session. Leave it empty and the route accepts a member
# session only, which means the bridge cannot post.
CHAT_INGRESS_KEY=


# --- Email ---
# To make the website send mail from administrator@male-cyber-fighters.com,
# choose a backend with EMAIL_PROVIDER.
#
#   smtp      (default) Send through any SMTP server with nodemailer. Use this
#             for a real mailbox that backs your domain address. Squarespace
#             itself does NOT host mailboxes (it only hosts the site + DNS), so
#             the mailbox lives on an external host. Google Workspace is the
#             standard choice and is integrated into the Squarespace admin.
#   resend    Transactional provider via HTTP API (recommended for mail this
#             app sends: welcome, password reset, admin alerts). Sign up at
#             https://resend.com and set RESEND_API_KEY.
#   sendgrid  Twilio SendGrid via HTTP API (https://sendgrid.com).
#   postmark  Postmark via HTTP API (https://postmarkapp.com).
#
# Regardless of backend, for good deliverability make sure your Squarespace
# domain DNS has SPF, DKIM and DMARC records, and remember there is only ONE
# allowed SPF record — merge the include: entries of every service you send
# from (e.g. Google Workspace AND Resend) into a single record.


# --- SMTP backend (EMAIL_PROVIDER=smtp) ---
# SMTP details for whatever hosts your domain mailbox:
#
#   Google Workspace      smtp.gmail.com
#   Zoho Mail             smtp.zoho.com
#   Outlook/Microsoft 365 smtp.office365.com
#   Namecheap Private     mail.privateemail.com
#   Fastmail              smtp.fastmail.com
#
# SMTP_USER must be the FULL sending address (e.g. administrator@male-cyber-fighters.com).
# Google Workspace / Gmail SMTP rejects a bare local part like "administrator".
# For security, use an App Password (enable 2FA first), not your login password.

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=                 # 587 = STARTTLS, 465 = SSL/TLS
SMTP_SECURE=false          # set true only when SMTP_PORT is 465
SMTP_USER=
SMTP_PASS=

# --- Transactional provider backends (EMAIL_PROVIDER=resend|sendgrid|postmark) ---
# Only fill in the API key matching your chosen EMAIL_PROVIDER.
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# The "from" address shown to recipients (all backends).
MAIL_FROM=administrator@male-cyber-fighters.com

# Send an email to the admin mailbox on every new user registration (true/false).
# Requires the SMTP settings above.
EMAIL_ADMIN_ALERTS=false

# --- Image + clip storage ---
# Avatars and chat images are hosted on ImgBB (https://api.imgbb.com), which
# keeps them off this server's disk. Without a key, image upload is disabled
# and the API answers no_imgbb_key.
IMGBB_API_KEY=

# --- Optional integrations ---
# Discord webhook for public chat messages.
Discord_webhook=

# Support channel webhook used by the in-app support reports.
Discord_Support=

# Discord bot token for forwarding website DMs to a member's Discord account.
DISCORD_BOT_TOKEN=

# The site's official Discord invite. Any Discord invite URL posted in the
# public chat, a custom room, or a DM is rewritten to this link before the
# message is stored or delivered. Defaults to https://discord.gg/CBetKKfyR9.
DISCORD_INVITE_URL=https://discord.gg/CBetKKfyR9

# Discord Bot for forwarding website DMs to user Discord accounts.
# Ensure the bot has "Server Members Intent" and "Message Content Intent" if needed,
# and add it to your server.

# Hp stamina-bar / dice-match API (https://github.com/CyberFights/Hp).
# Base URL of a running Hp server, e.g. https://hp-production.up.railway.app
# When set, the chat slash commands (/roll, /submit, /escape, /tease,
# /recover, /pin-escape, /create-game, /join-game, /move, /game-state,
# /end-game, /end-all-games) are resolved by that server through the
# /api/hp/* proxy. Leave empty to use the browser's built-in local dice
# engine instead.
HP_API_URL=

# SlamDB pro wrestling move database (https://wrestling-moves-production.up.railway.app).
# Upstream for the /get-move slash command, called through the /api/get-move
# proxy. Leave empty to use the live SlamDB app; set only to point at a
# staging / test instance.
MOVES_API_URL=

# --- Data retention ---
# How long each collection is kept before the nightly sweep deletes it, in
# days. Set a value to 0 to keep that collection forever. Anything unparsable
# falls back to the default rather than to "delete everything".
#
#   RETENTION_PUBLIC_DAYS   arena (public chat) transcript        default 180
#   RETENTION_ROOM_DAYS     custom room transcripts               default 180
#   RETENTION_IP_DAYS       IP + user agent log per auth attempt  default 30
#   RETENTION_RESET_DAYS    spent/expired password-reset tokens   default 1
#
# Direct messages are NOT pruned by default: they are member content, and
# stories are assembled out of them. Set RETENTION_DM_DAYS only if you want DM
# history to expire as well.
RETENTION_PUBLIC_DAYS=180
RETENTION_ROOM_DAYS=180
RETENTION_IP_DAYS=30
RETENTION_RESET_DAYS=1
RETENTION_DM_DAYS=0

# How often the sweep runs, and how many documents each delete touches. The
# batch size keeps a large backlog from becoming one long-running write.
RETENTION_INTERVAL_HOURS=6
RETENTION_BATCH=1000

# --- Web push ---
# Notifications for a DM that arrives while the member has no live session.
# Without a VAPID key pair the feature turns itself off: /api/push/config
# reports enabled=false and the client hides the control, so nothing breaks.
#
# Generate a pair once and keep the private key secret:
#   npx web-push generate-vapid-keys
#
# VAPID_SUBJECT is the contact the push service is given; it must be a mailto:
# or https: URL and defaults to https://male-cyber-fighters.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administrator@male-cyber-fighters.com
