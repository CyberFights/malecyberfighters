# Male Cyber Fighters — environment configuration
#
# Copy this file to `.env` (the server reads `.env`) and fill in your values.
#   cp .env.example .env
#
# The file is plain text and should NOT be committed. Keep it out of version
# control (`.env` is already ignored).

# --- Server ---
PORT=3000

# Public base URL used in password-reset emails (e.g. https://malecyberfighters.com).
# If left blank, the server derives it from the incoming request, which works
# behind a reverse proxy that sets X-Forwarded-Proto/Host.
APP_BASE_URL=

# --- Admin panel ---
# The x-admin-key required to access /api/admin/* endpoints.


# --- Email ---
# To make the website send mail from administrator@male-cyber-fighters.com,
# choose a backend with EMAIL_PROVIDER.
#
#   smtp      (default) Send through any SMTP server with nodemailer. Use this
#             for a real mailbox that backs your domain address. Squarespace
#             itself does NOT host mailboxes (it only hosts the site + DNS), so
#             the mailbox lives on an external host. Google Workspace is the
#             standard choice and is integrated into the Squarespace admin.
#   resend    Transactional provider via HTTP API (recommended for mail this
#             app sends: welcome, password reset, admin alerts). Sign up at
#             https://resend.com and set RESEND_API_KEY.
#   sendgrid  Twilio SendGrid via HTTP API (https://sendgrid.com).
#   postmark  Postmark via HTTP API (https://postmarkapp.com).
#
# Regardless of backend, for good deliverability make sure your Squarespace
# domain DNS has SPF, DKIM and DMARC records, and remember there is only ONE
# allowed SPF record — merge the include: entries of every service you send
# from (e.g. Google Workspace AND Resend) into a single record.


# --- SMTP backend (EMAIL_PROVIDER=smtp) ---
# SMTP details for whatever hosts your domain mailbox:
#
#   Google Workspace      smtp.gmail.com
#   Zoho Mail             smtp.zoho.com
#   Outlook/Microsoft 365 smtp.office365.com
#   Namecheap Private     mail.privateemail.com
#   Fastmail              smtp.fastmail.com
#
# SMTP_USER must be the FULL sending address (e.g. administrator@male-cyber-fighters.com).
# Google Workspace / Gmail SMTP rejects a bare local part like "administrator".
# For security, use an App Password (enable 2FA first), not your login password.

                 # 587 = STARTTLS, 465 = SSL/TLS
             # set true only when SMTP_PORT is 465

l

# --- Transactional provider backends (EMAIL_PROVIDER=resend|sendgrid|postmark) ---
# Only fill in the API key matching your chosen EMAIL_PROVIDER.


# The "from" address shown to recipients (all backends).


# Send an email to the admin mailbox on every new user registration (true/false).
# Requires the SMTP settings above.


# --- Optional integrations ---
# Discord webhook for public chat messages.
